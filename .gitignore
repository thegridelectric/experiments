# Committed data = sema instances + external evidence (with provenance
# headers). Generated CSVs and envs are never committed.
.env
__pycache__/
.ruff_cache/
*.pyc
.venv/
.DS_Store
*-display.csv
*-readable.csv
*-fold.png
.capture_broker.pid
# Minute-grid reductions of a season (dist-loop-experiments): 14 MB a
# house, regenerated from the journal DB by the folder's pump_speed.py.
*-minute.pump.json

# Workbooks and CSV folders are regenerated by each experiment's sheets.py.
*.xlsx
csv/
# Per-day API responses a puller caches; the committed evidence file is
# their reduction.
raw/
# Regenerated by a script in the folder from our own immutable store,
# named in its README with the command; never committed, never edited.
*-regen.*
