# The remote rig: the hw1-2 staging box (experiments/2026-09-06-fis-staging-box).
# Sourced by run-remote.sh and setup-remote.sh; nothing secret lives here.
BATTERY_RIG=remote
BATTERY_BROKER_HOST=hw1-2.electricity.works
BATTERY_AMQPS_PORT=5671
BATTERY_MQTTS_PORT=8883
BATTERY_RUN=hw1__2
# a run in the same universe that is not this vhost, and one outside it
BATTERY_OTHER_RUN=hw1__1
BATTERY_FOREIGN_RUN=d1__1
BATTERY_WEATHER_ALIAS=hw1.isone.weather
BATTERY_SCADA_ALIAS=hw1.isone.me.versant.keene.beech.scada
BATTERY_LTN_ALIAS=hw1.isone.me.versant.keene.beech
BATTERY_STALE_ALIAS=hw1.isone.price
BATTERY_CERTS_DIR=certs/remote
# ssh: the box's two logins and the broker container; certbot cuts the certs
BATTERY_FIS_LOGIN=fis@hw1-2.electricity.works
BATTERY_FIS_CHECKOUT=gridworks-fleet-index-service
BATTERY_BROKER_LOGIN=broker@hw1-2.electricity.works
BATTERY_BROKER_CONTAINER=rmq1
BATTERY_CERTBOT=certbot
BATTERY_GNR_URL=https://gnr.electricity.works
