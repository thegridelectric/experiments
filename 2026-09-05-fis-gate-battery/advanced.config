%% The broker's TLS block, whole: the material, verify_peer with a client
%% cert required (the tightening a staging box has from day one, prod's
%% notch 3), and client-cert revocation against the CA's CRL, read from the
%% mounted crl/ directory at every handshake (a directory mount, so a
%% replaced file is seen without a container recreate).
%%
%% Whole, not just the cache option: crl_cache has no rabbitmq.conf schema
%% key, and an ssl_options list here REPLACES rabbitmq.conf's ssl_options.*
%% keys rather than merging with them (witnessed on 4.1.8: a crl_cache-only
%% list left both TLS listeners with no_cert). So every ssl_options key
%% lives here, and rabbitmq.conf carries none. Shared by the AMQP and MQTT
%% listeners (mqtt.listeners.ssl takes the global block).
[{rabbit, [{ssl_options, [
    {cacertfile, "/certs/ca.pem"},
    {certfile,   "/certs/server.pem"},
    {keyfile,    "/certs/server.key"},
    {verify, verify_peer},
    {fail_if_no_peer_cert, true},
    {crl_check, peer},
    {crl_cache, {ssl_crl_hash_dir, {internal, [{dir, "/etc/rabbitmq/crl"}]}}}
]}]}].
